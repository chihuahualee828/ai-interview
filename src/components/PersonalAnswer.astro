---
import type {Locale} from '../lib/types';
import type {Messages} from '../lib/i18n';
const {id, locale, t} = Astro.props as {id: string; locale: Locale; t: Messages};
---
<section class="personal-answer" id="personal-answer" aria-labelledby="personal-title" data-question={id} data-locale={locale} data-labels={JSON.stringify(t.personal)}>
 <div class="personal-heading">
  <h3 id="personal-title">{t.personal.title}</h3>
  <button id="personal-edit" type="button" class="button button-quiet" disabled aria-controls="personal-editor" aria-expanded="false">{t.personal.edit}</button>
 </div>
 <p id="personal-privacy">{t.personal.privacy}</p>
 <div id="personal-preview" class="personal-preview community-prose" tabindex="0" role="region" aria-labelledby="personal-title"><p>{t.personal.empty}</p></div>
 <div id="personal-editor" hidden>
  <label for="personal-body">{t.personal.label}</label>
  <textarea id="personal-body" rows="8" maxlength="30000" disabled aria-describedby="personal-format-hint personal-shortcuts personal-status" autocomplete="off" placeholder={t.personal.placeholder}></textarea>
  <p id="personal-shortcuts">{t.personal.shortcuts}</p>
  <p id="personal-format-hint">{t.personal.formatHint}</p>
  <div class="personal-actions">
   <button id="personal-save" type="button" class="button button-primary" disabled>{t.personal.save}</button>
   <button id="personal-cancel" type="button" class="button button-quiet" disabled>{t.personal.cancel}</button>
  </div>
 </div>
 <p id="personal-status" role="status" aria-live="polite">{t.personal.unavailable}</p>
 <time id="personal-updated" hidden></time>
 <div class="personal-actions">
  <button id="personal-refresh" title={t.personal.conflicts} type="button" class="button button-quiet" disabled>{t.personal.refresh}</button>
  <button id="personal-delete" type="button" class="button button-quiet" disabled>{t.personal.delete}</button>
 </div>
</section>
<script>import '../client/personal-answers';</script>
