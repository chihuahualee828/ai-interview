# Server-side jobs only. Never prefix API keys with PUBLIC_.
LLM_API_KEY=
LLM_MODEL=
# An OpenAI-compatible endpoint; omitted uses https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_SOURCE_CHAR_LIMIT=30000
LLM_MAX_TOKENS=16000
GENERATION_LIMIT=10
GENERATION_SOURCE_FETCH_LIMIT=10
# Optional comma-separated question IDs for a targeted retry; empty processes all.
GENERATION_IDS=
SOURCE_FETCH_LIMIT=20
# Set both for GitHub project Pages, for example your host and /your-repository.
SITE_URL=http://localhost:4321
BASE_PATH=/

# Optional project repository override; otherwise use site.json or GitHub Actions context.
PROJECT_REPO_URL=

# Optional private personal-answer sync. Only public project configuration belongs here.
# Use your https://<project-ref>.supabase.co URL and sb_publishable_... (or legacy anon) key.
# NEVER use a Supabase secret/service-role key or a GitHub OAuth client secret.
# OAuth client ID/secret are configured ONLY in the Supabase dashboard.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
